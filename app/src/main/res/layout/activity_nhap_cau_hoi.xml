<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainNhapCauHoiLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical"
    tools:context="com.example.myquizz.activity.NhapCauHoiActivity">

    <!-- Thanh Header Trên Cùng -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <!-- Logo EduLand -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_eduland_logo" />

        <!-- Tên thương hiệu EduLand & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_title"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/brand_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Avatar cá nhân MA -->
        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="@string/avatar_placeholder"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Nội dung chính có thể cuộn -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Điều hướng quay lại: Tạo bộ câu hỏi -->
            <LinearLayout
                android:id="@+id/btnBackCreateSet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="6dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_back"
                    android:tint="@color/text_secondary"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/back_create_question_set"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Tiêu đề trang: Nhập câu hỏi thủ công -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_manual_question"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="@string/subtitle_manual_question"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Khung Thẻ Khối Câu Hỏi: Câu 1 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardQuestion1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/border_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Tên câu hỏi: Câu 1 -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/label_question_num_1"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Nhãn: Câu hỏi -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_question_text"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Ô nhập nội dung câu hỏi -->
                    <EditText
                        android:id="@+id/etQuestionContent"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:layout_marginBottom="18dp"
                        android:background="@drawable/bg_question_box"
                        android:gravity="top|start"
                        android:hint="@string/hint_question_content"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:padding="14dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp" />

                    <!-- Hàng Tiêu đề Đáp án và Đúng -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_answers"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_correct_answer"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="14dp"
                        android:text="@string/sub_select_correct_answer"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <!-- Ô Nhập Đáp án A -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_answer_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:text="@string/letter_a"
                                android:textColor="@color/primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="8dp"
                                android:background="@color/border_stroke" />

                            <EditText
                                android:id="@+id/etAnswerA"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="@string/hint_answer_a"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:paddingHorizontal="12dp"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <CheckBox
                            android:id="@+id/cbAnswerA"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:button="@drawable/bg_checkbox_circle" />
                    </LinearLayout>

                    <!-- Ô Nhập Đáp án B -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_answer_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:text="@string/letter_b"
                                android:textColor="@color/primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="8dp"
                                android:background="@color/border_stroke" />

                            <EditText
                                android:id="@+id/etAnswerB"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="@string/hint_answer_b"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:paddingHorizontal="12dp"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <CheckBox
                            android:id="@+id/cbAnswerB"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:button="@drawable/bg_checkbox_circle" />
                    </LinearLayout>

                    <!-- Ô Nhập Đáp án C -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_answer_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:text="@string/letter_c"
                                android:textColor="@color/primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="8dp"
                                android:background="@color/border_stroke" />

                            <EditText
                                android:id="@+id/etAnswerC"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="@string/hint_answer_c"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:paddingHorizontal="12dp"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <CheckBox
                            android:id="@+id/cbAnswerC"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:button="@drawable/bg_checkbox_circle" />
                    </LinearLayout>

                    <!-- Ô Nhập Đáp án D -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_answer_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="14dp"
                                android:text="@string/letter_d"
                                android:textColor="@color/primary"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="8dp"
                                android:background="@color/border_stroke" />

                            <EditText
                                android:id="@+id/etAnswerD"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@null"
                                android:hint="@string/hint_answer_d"
                                android:importantForAutofill="no"
                                android:inputType="text"
                                android:paddingHorizontal="12dp"
                                android:singleLine="true"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_secondary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <CheckBox
                            android:id="@+id/cbAnswerD"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:button="@drawable/bg_checkbox_circle" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Nút + Tạo thêm câu hỏi -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddMoreQuestion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_add_more_question"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/white"
                app:cornerRadius="25dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/primary"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp" />

            <!-- Nút Hoàn thành -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinish"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:text="@string/btn_finish"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="27dp"
                app:elevation="0dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
